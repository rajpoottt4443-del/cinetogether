# ==============================================================
# CineTogether - Environment Configuration (Supabase + Vercel)
# ==============================================================

# Supabase Project URL and Anon Public Key
# Find these in your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# (Optional Next.js aliases if deployed on Next.js)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Vercel Deployment Base URL
VITE_APP_URL="https://cinetogether.vercel.app"
